proc mix(int x, int bias) gives int {
  give x * 2 + bias;
}

proc hot_loop_a() gives int {
  auto total = 0;
  for int i in range(1, 3001) {
    total = total + mix(i, 5);
  }
  give total;
}

proc hot_loop_b() gives int {
  auto total = 0;
  for int i in range(1, 3001) {
    total = total + mix(i, 9);
  }
  give total;
}

proc cold_once() gives int {
  give mix(7, 1);
}

proc main() gives int {
  hot_loop_a();
  hot_loop_b();
  cold_once();
  give 0;
}
